# This is documentation; SAGE does not automatically load .env files.
# Export only the variables needed for your experiment.
SAGE_WORKDIR=./runs
SAGE_NPU_HOST=
SAGE_NPU_USER=
SAGE_NPU_PORT=22
SAGE_NPU_KEY_FILE=
SAGE_CUDA_HOST=
SAGE_CUDA_USER=
SAGE_CUDA_PORT=22
SAGE_CUDA_ROOT=/usr/local/cuda
# Optional: SAGE_CUDA_SETUP points to an environment setup script.
SAGE_CUDA_KEY_FILE=
SAGE_KNOWN_HOSTS=
SAGE_REMOTE_ROOT=/tmp/sage
SAGE_CANN_ROOT=/usr/local/Ascend/ascend-toolkit/latest
# Optional: SAGE_NPU_SETUP points to the toolkit set_env.sh file.
SAGE_LLM_BACKEND=openai
# SiliconFlow example: https://api.siliconflow.cn/v1
SAGE_LLM_BASE_URL=
# SiliconFlow model example: deepseek-ai/DeepSeek-V3.2
SAGE_LLM_MODEL=
# Supply your own key through the environment. Never commit a real key here.
SAGE_LLM_API_KEY=
SAGE_LLM_TIMEOUT=180
SAGE_LLM_DISABLE_THINKING=1
